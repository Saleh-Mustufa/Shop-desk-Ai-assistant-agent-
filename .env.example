# Copy to .env and fill in. NEVER commit .env (NFR-1).
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: force the first model in every fallback chain (router reads this)
# PRIORITY_MODEL=gemini-2.5-flash

# Optional per-model quota overrides (router defaults otherwise), e.g.:
# TPM_GEMINI_2_5_FLASH=250000
# RPD_GEMINI_2_5_FLASH=250
